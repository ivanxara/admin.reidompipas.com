{
  "openapi": "3.1.0",
  "info": {
    "title": "Restaurant Menu API",
    "description": "Pré-visualiza e atualiza vários pratos do menu Daily ou Menu/Carta por nome ou ID.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://admin-reidompipas-com-v2.vercel.app"
    }
  ],
  "paths": {
    "/api/ai/update-menu": {
      "post": {
        "operationId": "updateMenuItem",
        "summary": "Pré-visualizar ou atualizar pratos do menu",
        "description": "Use confirmed false para pré-visualizar. Confirme todas as alterações de 2+ pratos numa lista. Se houver dúvida, ambiguidade ou prato não encontrado, peça esclarecimento e não atualize. Após confirmação, repita com confirmed true. Use active para Active; special e everyday só no daily.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMenuRequest"
              },
              "examples": {
                "updatePrice": {
                  "summary": "Alterar preço",
                  "value": {
                    "confirmed": false,
                    "menu": "daily",
                    "updates": [
                      {
                        "productName": "Bacalhau a Bras",
                        "price": 14.5
                      },
                      {
                        "productName": "Arroz de marisco",
                        "active": false,
                        "special": true,
                        "everyday": false
                      }
                    ]
                  }
                },
                "toggleAvailability": {
                  "summary": "Alterar disponibilidade",
                  "value": {
                    "confirmed": false,
                    "menu": "menu",
                    "updates": [
                      {
                        "itemId": 123,
                        "active": false
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Item atualizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "$ref": "#/components/schemas/PreviewResponse" },
                    { "$ref": "#/components/schemas/SuccessResponse" }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Pedido inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Um ou mais pratos não foram encontrados. Não executar alterações; pedir esclarecimento ao utilizador."
          },
          "409": {
            "description": "Nome de prato ambíguo ou pedido inconsistente. Não executar alterações; pedir esclarecimento ao utilizador."
          },
          "500": {
            "description": "Erro ao atualizar a base de dados"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UpdateMenuRequest": {
        "type": "object",
        "required": [
          "confirmed",
          "menu",
          "updates"
        ],
        "properties": {
          "confirmed": {
            "type": "boolean",
            "description": "false para pré-visualizar os valores atuais; true apenas depois da confirmação explícita do utilizador."
          },
          "menu": {
            "type": "string",
            "enum": ["daily", "menu"],
            "description": "daily para o menu de diárias; menu para Menu/Carta."
          },
          "updates": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/MenuUpdate"
            },
            "description": "Lista de pratos a atualizar."
          }
        },
        "additionalProperties": false
      },
      "MenuUpdate": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "integer",
            "minimum": 1,
            "description": "ID da linha do item em newMenus."
          },
          "productName": {
            "type": "string",
            "description": "Nome do prato; pode ser aproximado do nome guardado na base de dados."
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "description": "Novo preço do produto."
          },
          "active": {
            "type": "boolean",
            "description": "Estado Active: mostrar ou não o prato no menu selecionado."
          },
          "special": {
            "type": "boolean",
            "description": "Estado Special, apenas no menu daily."
          },
          "everyday": {
            "type": "boolean",
            "description": "Estado Everyday, apenas no menu daily."
          }
        },
        "anyOf": [
          { "required": ["itemId"] },
          { "required": ["productName"] }
        ],
        "additionalProperties": false
      },
      "PreviewResponse": {
        "type": "object",
        "required": ["success", "confirmed", "message", "updates"],
        "properties": {
          "success": { "type": "boolean", "const": true },
          "confirmed": { "type": "boolean", "const": false },
          "message": { "type": "string" },
          "updates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "productName": { "type": "string" },
                "currentPrice": { "type": ["number", "null"] },
                "newPrice": { "type": ["number", "null"] },
                "currentStatus": { "type": ["boolean", "null"] },
                "newActive": { "type": ["boolean", "null"] },
                "currentSpecial": { "type": ["boolean", "null"] },
                "newSpecial": { "type": ["boolean", "null"] },
                "currentEveryday": { "type": ["boolean", "null"] },
                "newEveryday": { "type": ["boolean", "null"] }
              }
            }
          }
        }
      },
      "SuccessResponse": {
        "type": "object",
        "required": [
          "success",
          "message"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "success",
          "message"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object"
          }
        }
      }
    }
  }
}
